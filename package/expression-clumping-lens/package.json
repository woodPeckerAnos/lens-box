{
  "name": "@lsby/lens-box-expression-clumping-lens",
  "version": "0.1.0",
  "private": true,
  "description": "用同一份语料里的同频字串作参照，观察表达在文档之间的集中程度",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "tsx demo/basic-demo.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.2"
  }
}
