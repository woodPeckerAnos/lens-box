{
  "name": "@lsby/lens-box-psychology-style-lens",
  "version": "0.0.1",
  "description": "基于心理学视角分析文本人物性格与对话场景的文风建模透镜",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "tsx demo/basic-demo.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lsby/ai-agent": "^0.1.3",
    "openai": "^4.104.0",
    "zod": "^3.24.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
