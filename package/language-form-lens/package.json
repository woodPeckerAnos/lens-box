{
  "name": "@lsby/lens-box-language-form-lens",
  "version": "0.0.1",
  "description": "纯本地的中文文章语言形式、词汇组合与句段节奏分析透镜",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "tsx demo/basic-demo.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@node-rs/jieba": "^2.0.4",
    "zod": "^3.24.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
